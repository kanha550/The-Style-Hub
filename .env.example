# Copy this file to .env for local development
# Never commit .env to git

# PostgreSQL connection string (required)
# Get a free one from https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret key for signing JWT tokens (use a long random string in production)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# Restrict CORS to your frontend domain in production (optional, defaults to *)
# CORS_ORIGIN=https://your-service.run.app

# Port (Cloud Run sets this automatically to 8080)
PORT=8080
